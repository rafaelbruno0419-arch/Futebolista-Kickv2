# Copie para .env (ou exporte no Termux) e ajuste conforme necessário.

# Servidor web
PORT=3000
HOST=0.0.0.0

# Conexão com o Tor (SocksPort do torrc)
TOR_PROXY_HOST=127.0.0.1
TOR_PROXY_PORT=9050

# ControlPort (necessário apenas para o botão "Nova identidade")
TOR_CONTROL_HOST=127.0.0.1
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=

# Proteção opcional da API/proxy
AUTH_TOKEN=
